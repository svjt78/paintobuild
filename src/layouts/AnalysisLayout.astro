---
// Shared template for research articles, both /evidence/ and /diagnostics/.
// Originally Design & Build Specification v1.1, §9.2; revised for the
// advisory site. Articles are plain research guidance: the text comes from
// the Markdown body, and the layout adds dates, related links, sources and
// the closing call to action from frontmatter. No scores or counts are shown.
import BaseLayout from './BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import SourceList from '../components/content/SourceList.astro';
import CtaBand from '../components/convert/CtaBand.astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import { articlePath, articleOgKey, stageLabel } from '../lib/routes';

interface Props {
  entry: CollectionEntry<'analysis'>;
  Content: any;
}
const { entry, Content } = Astro.props;
const { data } = entry;
const pagePath = articlePath(entry);

const related = data.related ? await getEntry('analysis', data.related) : undefined;
if (data.related && !related) throw new Error(`Unknown related article "${data.related}" in ${entry.id}`);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const wasUpdated = iso(data.updated) !== iso(data.published);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: iso(data.published),
  dateModified: iso(data.updated),
  author: { '@type': 'Organization', name: 'PainToBuild' },
  citation: data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })),
};
---
<BaseLayout
  title={`${data.title} | PainToBuild`}
  description={data.description}
  noindex={data.noindex}
  ogImagePath={`/open-graph/${articleOgKey(entry)}.png`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="wrap section prose analysis">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/evidence/">Research</a>
    </nav>
    <Kicker>{stageLabel[data.stage]}</Kicker>
    <h1>{data.question}</h1>
    <p class="dates">
      Published <time datetime={iso(data.published)}>{dateFmt(data.published)}</time>
      {wasUpdated && <>. Updated <time datetime={iso(data.updated)}>{dateFmt(data.updated)}</time></>}
    </p>

    <div class="analysis-body">
      <Content />
    </div>

    <ul class="link-list further">
      {related && (
        <li>Related article: <a href={articlePath(related)}>{data.relatedLabel ?? related.data.title}</a></li>
      )}
      <li><a href={data.methodHref}>How I use research</a></li>
    </ul>

    {data.sources.length > 0 && (
      <section class="sources-section" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources</h2>
        <p class="sources-intro">
          These are the public posts and pages behind the original research. A source link may show
          the writer's name even though this page does not.
        </p>
        <SourceList sources={data.sources} pagePath={pagePath} />
      </section>
    )}
  </article>

  <CtaBand
    heading="Need help with your own situation?"
    body="I can review what you are working on and suggest what to test next."
    ctaHref={data.cta.primary.href}
    ctaLabel={data.cta.primary.label}
    secondaryHref={data.cta.secondary?.href}
    secondaryLabel={data.cta.secondary?.label}
    pagePath={pagePath}
    ctaId="article-end"
  />
</BaseLayout>

<style>
  .section { padding-block: var(--s7) var(--s8); }
  .breadcrumb { font-size: var(--t-caption); color: var(--muted); margin-bottom: var(--s5); }
  .breadcrumb a { color: var(--muted); }
  .breadcrumb a:hover { color: var(--build); }

  h1 { margin-bottom: var(--s3); }
  .dates { font-size: var(--t-caption); color: var(--muted); margin-bottom: var(--s6) !important; }

  .analysis-body :global(h2) { margin-top: var(--s7); margin-bottom: var(--s3); }
  .analysis-body :global(p) { margin: 0 0 var(--s4); }
  .analysis-body :global(p:first-child) { font-size: var(--t-lede); color: var(--ink-soft); }
  .analysis-body :global(.table-scroll) { overflow-x: auto; margin: var(--s5) 0; }
  .analysis-body :global(table) {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: var(--t-body-s);
    line-height: 1.5;
  }
  .analysis-body :global(th), .analysis-body :global(td) {
    text-align: left;
    padding: var(--s3);
    border: 1px solid var(--hairline);
    vertical-align: top;
  }
  .analysis-body :global(th) { background: var(--surface-sunken); }

  .further { margin-top: var(--s7); padding-top: var(--s5); border-top: 1px solid var(--hairline); }
  .sources-section { margin-top: var(--s8); }
  .sources-intro { color: var(--muted); font-size: var(--t-body-s); }
</style>
