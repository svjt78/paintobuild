---
const nav = [
  { href: '/evidence/', label: 'Evidence' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/brief/', label: 'The Brief' },
  { href: '/everyday/', label: 'Everyday Audits' },
  { href: '/analysis/', label: 'Analysis' },
];

const gumroadHref = 'https://paintobuild.gumroad.com';
const pagePath = Astro.url.pathname;
---
<header class="site-header shell-dark">
  <div class="wrap bar">
    <a href="/" class="wordmark">
      <img
        src="/brand/wordmark-for-dark.png"
        alt="paintobuild"
        width="220"
        height="73"
        class="wordmark-img"
      />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav-cta">
      <a class="btn btn-secondary" href="/tools/evidence-ledger-template/">Get the template</a>
      <a
        class="btn btn-primary"
        href={gumroadHref}
        target="_blank"
        rel="noopener noreferrer"
        data-event="cta_click"
        data-event-page={pagePath}
        data-event-cta-id="header-shop"
      >
        Shop on Gumroad
      </a>
    </div>

    <details class="nav-mobile">
      <summary aria-label="Menu">Menu</summary>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/tools/evidence-ledger-template/">Get the template</a></li>
        <li>
          <a
            class="shop-mobile"
            href={gumroadHref}
            target="_blank"
            rel="noopener noreferrer"
            data-event="cta_click"
            data-event-page={pagePath}
            data-event-cta-id="header-shop-mobile"
          >
            Shop on Gumroad ↗
          </a>
        </li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header { position: relative; z-index: 10; }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s5);
    height: 64px;
  }
  @media (min-width: 768px) { .bar { height: 72px; } }

  .wordmark { display: block; line-height: 0; flex-shrink: 0; }
  .wordmark-img { height: 24px; width: auto; }
  @media (max-width: 480px) {
    .wordmark-img { height: 36px; width: 36px; object-fit: cover; object-position: left; }
  }

  .nav-desktop { display: none; margin-left: var(--s6); flex: 1; }
  .nav-desktop ul { display: flex; gap: var(--s6); list-style: none; margin: 0; padding: 0; }
  .nav-desktop a {
    color: var(--on-dark-muted);
    text-decoration: none;
    font-size: var(--t-body-s);
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-desktop a:hover { color: var(--on-dark); }

  .nav-cta { display: none; margin-left: auto; align-items: center; gap: var(--s3); }

  /* The full desktop nav (5 links + 2 CTA buttons) needs ~1060px of natural
     width. Below that it overflows -- verified via a live-site audit that found
     horizontal overflow at 768px and 1024px (iPad portrait/landscape, and any
     narrower laptop window). The hamburger menu covers everything under 1100px
     instead, so there's no gap where neither treatment fits. */
  @media (min-width: 1100px) {
    .nav-desktop { display: block; }
    .nav-cta { display: flex; }
    .nav-mobile { display: none; }
  }

  .nav-mobile { margin-left: auto; }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    color: var(--on-dark);
    font-weight: 700;
    padding: var(--s2) var(--s3);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile[open] summary { color: var(--pain-on-dark); }
  .nav-mobile ul {
    position: absolute;
    right: var(--gutter);
    top: 100%;
    background: var(--surface-dark-raised);
    border: 1px solid var(--hairline-dark);
    border-radius: var(--r-card);
    list-style: none;
    margin: var(--s2) 0 0;
    padding: var(--s3);
    min-width: 220px;
  }
  .nav-mobile a {
    display: block;
    padding: var(--s2) var(--s2);
    color: var(--on-dark-muted);
    text-decoration: none;
    font-weight: 600;
  }
  .nav-mobile a:hover { color: var(--on-dark); }
  .nav-mobile .shop-mobile { color: var(--build-on-dark); font-weight: 700; }
  .nav-mobile .shop-mobile:hover { color: #5BD6BB; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s5);
    border-radius: var(--r-pill);
    font-weight: 700;
    font-size: var(--t-body-s);
    text-decoration: none;
    border: 1.5px solid transparent;
    white-space: nowrap;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--build-on-dark);
    color: var(--ink);
  }
  .btn-primary:hover { background: #5BD6BB; color: var(--ink); }
  .btn-secondary {
    border-color: var(--hairline-dark);
    color: var(--on-dark-muted);
    background: transparent;
  }
  .btn-secondary:hover { color: var(--on-dark); border-color: var(--on-dark-muted); }
</style>
