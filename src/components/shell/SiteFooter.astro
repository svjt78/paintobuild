---
// Site footer. Groups and text from the approved copy
// (advisory_based_specs/02_Replacement_Copy.md, "Shared navigation").
// No automatic review date: a build is not a review.
import { SHOP_URL } from '../../lib/routes';

const groups = [
  {
    title: 'Work with me',
    links: [
      { href: '/advisory/', label: 'How I can help' },
      { href: '/methodology/', label: 'How it works' },
      { href: '/example-review/', label: 'Example review' },
      { href: '/contact/', label: 'Contact me' },
    ],
  },
  {
    title: 'Research and resources',
    links: [
      { href: '/evidence/', label: 'Research articles' },
      { href: '/resources/', label: 'Guides and tools' },
      { href: '/tools/evidence-ledger-template/', label: 'Free research template' },
      { href: '/brief/', label: 'Builder Validation Brief' },
      { href: '/challenge-mining-kit/', label: 'Challenge Mining Kit' },
      { href: SHOP_URL, label: 'Visit the shop', external: true },
    ],
  },
  {
    title: 'About and policies',
    links: [
      { href: '/about/', label: 'About PainToBuild' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
    ],
  },
];
---
<footer class="site-footer shell-dark">
  <div class="wrap">
    <div class="cols">
      <div class="intro">
        <p><strong>Help with your product and business decisions.</strong> From choosing a problem to working out what to try next.</p>
      </div>
      {groups.map((group) => (
        <div>
          <h2 class="col-title">{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                {link.external ? (
                  <a href={link.href} target="_blank" rel="noopener noreferrer"
                     data-event="shop_link_click" data-event-page="footer" data-event-cta-id="footer-shop">
                    {link.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens Gumroad in a new tab)</span>
                  </a>
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="sign-off">
      <svg width="40" height="40" viewBox="0 0 1024 1024" aria-hidden="true" class="sign-off-mark">
        <defs>
          <mask id="arrow-cut-footer" maskUnits="userSpaceOnUse" x="0" y="0" width="1024" height="1024">
            <rect width="1024" height="1024" fill="white"/>
            <path d="M432 520h88v-42l98 97-98 97v-42h-88z" fill="black"/>
          </mask>
        </defs>
        <g fill="#FFFFFF" stroke="#FFFFFF" mask="url(#arrow-cut-footer)">
          <rect x="168" y="295" width="116" height="545" rx="12" stroke="none"/>
          <circle cx="358" cy="575" r="190" fill="none" stroke-width="116"/>
          <rect x="476" y="295" width="116" height="280" rx="12" stroke="none"/>
          <circle cx="666" cy="575" r="190" fill="none" stroke-width="116"/>
        </g>
        <circle cx="226" cy="220" r="46" fill="#FFFFFF"/>
        <rect x="490" y="174" width="92" height="92" rx="14" fill="#FFFFFF"/>
      </svg>
      <p>PainToBuild</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-dark-deep); padding-block: var(--s8) var(--s6); }
  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s6);
  }
  @media (min-width: 768px) {
    .cols { grid-template-columns: 1.4fr repeat(3, 1fr); }
  }
  .col-title {
    font-size: var(--t-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--on-dark-quiet);
    margin: 0 0 var(--s3);
  }
  .cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .cols a { color: var(--on-dark-muted); text-decoration: none; font-size: var(--t-body-s); }
  .cols a:hover { color: var(--on-dark); }
  .intro p { margin: 0; color: var(--on-dark-muted); font-size: var(--t-body-s); max-width: 32ch; }
  .intro strong { color: var(--on-dark); }

  .sign-off {
    margin-top: var(--s8);
    padding-top: var(--s6);
    border-top: 1px solid var(--hairline-dark);
    text-align: center;
  }
  .sign-off-mark { opacity: 0.5; margin-bottom: var(--s3); }
  .sign-off p { margin: 0; color: var(--on-dark-quiet); font-size: var(--t-caption); }
</style>
