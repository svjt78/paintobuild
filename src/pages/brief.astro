---
// Builder Validation Brief. Copy: advisory_based_specs/02_Replacement_Copy.md §10.
// Price, page count and edition were checked against the public Gumroad
// listing on 2026-09-27 ($19, 18 page PDF, "Vol. 1, 2026 Q3", future volumes
// not included). The PDF itself was not inspected. The four topics describe
// the existing chapters in plain language; they do not rename the file.
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import Button from '../components/convert/Button.astro';
import { BRIEF_URL } from '../lib/routes';

const title = 'Builder Validation Brief | Research examples for founders';
const description = 'Read four examples of research into founder problems, with sources and suggested next steps. The PDF has 18 pages and costs $19.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'The Builder Validation Brief',
  description,
  brand: { '@type': 'Brand', name: 'PainToBuild' },
  offers: { '@type': 'Offer', price: '19', priceCurrency: 'USD', url: BRIEF_URL },
};
---
<BaseLayout title={title} description={description} ogImagePath="/open-graph/brief.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="wrap section prose">
    <Kicker>Guides and tools</Kicker>
    <h1>The Builder Validation Brief</h1>
    <p class="facts">$19 <span aria-hidden="true">|</span> PDF with 18 pages <span aria-hidden="true">|</span> Volume 1, July to September 2026</p>
    <p class="lede">
      This guide contains four examples of research into problems founders describe in public.
      Each looks at what the information suggests and what still needs checking.
    </p>

    <h2>What is inside</h2>
    <ul>
      <li>Finding possible customers when few people know about your product.</li>
      <li>Deciding what to look into after a launch gets little response.</li>
      <li>Testing an idea when you do not have an audience.</li>
      <li>Researching what others charge for a particular kind of work.</li>
    </ul>
    <p>Each example includes source material, a worksheet for comparing the findings and a suggested first step.</p>
    <p class="panel">
      The suggested steps have not been tested for results. The pricing example has less
      supporting evidence than the other three.
    </p>

    <h2>What your purchase includes</h2>
    <p>
      You receive this edition of the guide. Future volumes are separate purchases. Personal advice
      about your own product is a separate service.
    </p>
    <div class="buy">
      <Button href={BRIEF_URL} external srNote="(opens Gumroad in a new tab)"
              dataEvent="resource_checkout_click" dataEventPage="/brief/" dataEventCtaId="brief-buy">
        Buy the Brief for $19
      </Button>
      <p class="button-note">Opens Gumroad.</p>
    </div>

    <h2>Other ways to get help</h2>
    <p>
      The Challenge Mining Kit explains how to do the research yourself. It uses the same four
      examples among its worked cases.
    </p>
    <p>For help with your own decision, read about the advisory service.</p>
    <ul class="link-list">
      <li><a href="/challenge-mining-kit/">Read about the Kit</a></li>
      <li><a href="/advisory/">See how I can help</a></li>
      <li><a href="/tools/evidence-ledger-template/">Get the free template</a></li>
      <li><a href="/resources/">Compare all guides and tools</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--s7) var(--s8); }
  .facts { font-weight: 700; color: var(--build); margin: var(--s3) 0 var(--s4) !important; }
  .facts span { color: var(--muted); font-weight: 400; margin-inline: var(--s1); }
  .buy { margin: var(--s5) 0 var(--s4); }
  .button-note { font-size: var(--t-caption); color: var(--muted); margin: var(--s2) 0 0 !important; }
</style>
