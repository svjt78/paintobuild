---
// Site header. Menu labels and the main button come from the approved copy
// (advisory_based_specs/02_Replacement_Copy.md, "Shared navigation").
import { MAIN_CTA } from '../../lib/routes';

const nav = [
  { href: '/advisory/', label: 'Work with me' },
  { href: '/methodology/', label: 'How it works' },
  { href: '/evidence/', label: 'Research' },
  { href: '/resources/', label: 'Guides and tools' },
  { href: '/about/', label: 'About' },
];

const pagePath = Astro.url.pathname;
const isCurrent = (href: string) => pagePath === href || (href !== '/' && pagePath.startsWith(href));
---
<header class="site-header shell-dark">
  <div class="wrap bar">
    <a href="/" class="wordmark">
      <img
        src="/brand/wordmark-for-dark.png"
        alt="PainToBuild home"
        width="220"
        height="73"
        class="wordmark-img"
      />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav-cta">
      <a
        class="btn btn-primary"
        href={MAIN_CTA.href}
        data-event="advisory_cta_click"
        data-event-page={pagePath}
        data-event-cta-id="header-main"
      >
        {MAIN_CTA.label}
      </a>
    </div>

    <details class="nav-mobile">
      <summary>Menu</summary>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li class="mobile-cta">
            <a
              class="btn btn-primary"
              href={MAIN_CTA.href}
              data-event="advisory_cta_click"
              data-event-page={pagePath}
              data-event-cta-id="header-main-mobile"
            >
              {MAIN_CTA.label}
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Stays at the top while the page scrolls. Anchor links land below it
     because base.css sets scroll-padding-top from --header-h. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--hairline-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s5);
    height: var(--header-h);
  }

  .wordmark { display: block; line-height: 0; flex-shrink: 0; }
  .wordmark-img { height: 24px; width: auto; }
  @media (max-width: 480px) {
    .wordmark-img { height: 36px; width: 36px; object-fit: cover; object-position: left; }
  }

  .nav-desktop { display: none; margin-left: var(--s6); flex: 1; }
  .nav-desktop ul { display: flex; gap: var(--s6); list-style: none; margin: 0; padding: 0; }
  .nav-desktop a {
    color: var(--on-dark-muted);
    text-decoration: none;
    font-size: var(--t-body-s);
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] { color: var(--on-dark); }
  .nav-desktop a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.35em; }

  .nav-cta { display: none; margin-left: auto; align-items: center; gap: var(--s3); }

  /* Five menu links plus the main button need roughly 1040px. Below 1100px
     the menu moves into the "Menu" panel, so there is no width where the
     desktop row overflows. Rechecked after the advisory labels were added. */
  @media (min-width: 1100px) {
    .nav-desktop { display: block; }
    .nav-cta { display: flex; }
    .nav-mobile { display: none; }
  }

  .nav-mobile { margin-left: auto; }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    color: var(--on-dark);
    font-weight: 700;
    padding: var(--s2) var(--s3);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile[open] summary { color: var(--pain-on-dark); }
  .nav-mobile ul {
    position: absolute;
    right: var(--gutter);
    top: 100%;
    background: var(--surface-dark-raised);
    border: 1px solid var(--hairline-dark);
    border-radius: var(--r-card);
    list-style: none;
    margin: var(--s2) 0 0;
    padding: var(--s3);
    min-width: 240px;
    max-width: calc(100vw - 2 * var(--gutter));
    /* Opened partway down a short screen, the panel scrolls inside itself. */
    max-height: calc(100vh - var(--header-h) - var(--s4));
    overflow-y: auto;
  }
  .nav-mobile a {
    display: block;
    padding: var(--s2) var(--s2);
    color: var(--on-dark-muted);
    text-decoration: none;
    font-weight: 600;
  }
  .nav-mobile a:hover,
  .nav-mobile a[aria-current='page'] { color: var(--on-dark); }
  .nav-mobile .mobile-cta { margin-top: var(--s3); padding-top: var(--s3); border-top: 1px solid var(--hairline-dark); }
  .nav-mobile .mobile-cta .btn {
    display: flex;
    color: var(--ink);
    white-space: normal;
    text-align: center;
    line-height: 1.3;
    padding: var(--s2) var(--s4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s5);
    border-radius: var(--r-pill);
    font-weight: 700;
    font-size: var(--t-body-s);
    text-decoration: none;
    border: 1.5px solid transparent;
    white-space: nowrap;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--build-on-dark);
    color: var(--ink);
  }
  .btn-primary:hover { background: #5BD6BB; color: var(--ink); }
  .btn-secondary {
    border-color: var(--hairline-dark);
    color: var(--on-dark-muted);
    background: transparent;
  }
  .btn-secondary:hover { color: var(--on-dark); border-color: var(--on-dark-muted); }
</style>
