---
// About. Copy: advisory_based_specs/02_Replacement_Copy.md §8.
// No biography, credentials or client results are claimed. Add them only
// when they can be supported.
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import CtaBand from '../components/convert/CtaBand.astro';

const title = 'About PainToBuild | Help for founders';
const description = 'I help founders think through product and business decisions. Learn how I use questions, research and small tests, and see an example of the work.';
---
<BaseLayout title={title} description={description} ogImagePath="/open-graph/about.png">
  <section class="wrap section prose">
    <Kicker>About</Kicker>
    <h1>About PainToBuild</h1>
    <p class="lede">I help founders choose what to work on and decide what to try when a product is struggling.</p>
    <p>
      The starting point is your situation. I want to understand the product, the people it is
      meant to help and what you have already tried.
    </p>

    <h2>How I work</h2>
    <p>
      I ask questions, look at the information available and compare the options. I explain why I
      recommend a step and what could change that recommendation.
    </p>
    <p>
      Research is part of the work. Public discussions can suggest problems to look into. Your
      product, customer conversations and results help me understand what applies to you.
    </p>

    <h2>See the work before asking for help</h2>
    <p>
      The service page explains what a review includes. The example page shows the kind of written
      review you would receive.
    </p>
    <p>The example is made up to show the format. It is not a client result.</p>
    <ul class="link-list">
      <li><a href="/advisory/">What the service includes</a></li>
      <li><a href="/methodology/">How it works</a></li>
      <li><a href="/example-review/">Example review</a></li>
    </ul>

    <h2>About my professional identity</h2>
    <p>
      I keep PainToBuild separate from my unrelated professional work. Before taking on a review, I
      agree with you on the work, communication and handling of your information.
    </p>
  </section>

  <CtaBand
    heading="Tell me what you are working on"
    body="Send a short message about your idea or product and where you need help."
    pagePath="/about/"
    ctaId="about-end"
  />
</BaseLayout>

<style>
  .section { padding-block: var(--s7) var(--s8); }
</style>
