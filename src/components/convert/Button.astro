---
// Pill button link. Event names describe the click only, never a later
// outcome: a click on a mailto link is not a sent inquiry, and a click on a
// Gumroad link is not a purchase. No script listens for these yet.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  dark?: boolean;
  /** Opens in a new tab with rel="noopener noreferrer". */
  external?: boolean;
  /** Visually hidden text read after the label, e.g. "(opens Gumroad)". */
  srNote?: string;
  dataEvent?: string;
  dataEventPage?: string;
  dataEventCtaId?: string;
}
const {
  href, variant = 'primary', dark = false, external = false, srNote,
  dataEvent, dataEventPage, dataEventCtaId,
} = Astro.props;
---
<a
  href={href}
  class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', dark && 'btn-dark']}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-event={dataEvent}
  data-event-page={dataEventPage}
  data-event-cta-id={dataEventCtaId}
><slot />{srNote && <span class="visually-hidden"> {srNote}</span>}</a>
<style>
  .btn { transition: background-color 150ms ease-out, color 150ms ease-out; }
  .btn-dark.btn-primary { background: var(--build-on-dark); color: var(--ink); }
  .btn-dark.btn-primary:hover { background: #5BD6BB; color: var(--ink); }
  .btn-dark.btn-secondary { border-color: var(--on-dark); color: var(--on-dark); }
  .btn-dark.btn-secondary:hover { background: rgb(247 245 239 / .08); color: var(--on-dark); }
</style>
