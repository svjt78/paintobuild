---
// Free template. Copy: advisory_based_specs/02_Replacement_Copy.md §12,
// changed on 2026-09-27 from an email signup (MailerLite, double opt-in) to a
// direct download with no email address. The file is
// public/downloads/evidence-ledger-template.xlsx. The table explains its seven
// Ledger columns. The example row is made up.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/content/Kicker.astro';
import Button from '../../components/convert/Button.astro';

const title = 'Free template for your problem research | PainToBuild';
const description = 'Keep track of problem reports, their sources and repeated accounts with a free research template. Download it as a spreadsheet. No email address needed.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Free template for your problem research',
  description,
  publisher: { '@type': 'Organization', name: 'PainToBuild' },
};
---
<BaseLayout title={title} description={description} ogImagePath="/open-graph/tools-evidence-ledger-template.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="wrap section prose">
    <Kicker>Free template</Kicker>
    <h1>Keep your problem research in one place</h1>
    <p class="lede">
      The free evidence ledger is a template for recording what people say about a problem and
      where you found it. It helps you avoid counting the same person's account more than once.
    </p>

    <h2>What to record</h2>
    <p>
      Note the source, the date and what the person describes. Record whether it is a separate
      person's experience and how it relates to the problem you are studying.
    </p>
    <div class="table-scroll" role="region" aria-labelledby="ledger-caption" tabindex="0">
      <table class="data-table ledger">
        <caption id="ledger-caption">This made up example shows how to organize a row. It is not a research finding.</caption>
        <thead>
          <tr>
            <th scope="col">Record</th><th scope="col">Problem</th><th scope="col">Source</th>
            <th scope="col">Different person?</th><th scope="col">Date</th>
            <th scope="col">What was reported?</th><th scope="col">Count it?</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Example 1</td>
            <td>Example A</td>
            <td>Made up example</td>
            <td>Not checked</td>
            <td>Not applicable</td>
            <td>A founder describes difficulty finding possible customers</td>
            <td>No, this is only an example</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 id="get-the-template">Get the template</h2>
    <p>
      The template is an Excel file. It also opens in Google Sheets, Numbers and LibreOffice. You
      do not need to give me your email address.
    </p>
    <p>
      <Button href="/downloads/evidence-ledger-template.xlsx" dataEvent="template_download_click"
        dataEventPage="/tools/evidence-ledger-template/" dataEventCtaId="template-download">
        Download the template
      </Button>
    </p>
    <p>
      It has three tabs: how to use it, the ledger itself with one made up example row, and a few
      totals that update as you add rows.
    </p>

    <ul class="link-list end-links">
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/methodology/">How I use research</a></li>
      <li><a href="/resources/">Guides and tools</a></li>
      <li><a href="/advisory/">Need help with your own product?</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--s7) var(--s8); }
  .ledger { min-width: 720px; }
  .ledger th { white-space: nowrap; }
  .end-links { margin-top: var(--s7); padding-top: var(--s5); border-top: 1px solid var(--hairline); }
</style>
