---
// Home. Copy: advisory_based_specs/02_Replacement_Copy.md §1.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import CtaBand from '../components/convert/CtaBand.astro';
import { articlePath, MAIN_CTA } from '../lib/routes';

const title = 'Help with your product and business decisions | PainToBuild';
const description = 'I help founders choose problems to work on, think through product ideas and find out why a product is struggling. Start with the decision you need help with.';

// Home wording for each article differs slightly from the article titles,
// as written in the approved copy. Paths come from the collection.
const researchItems = await Promise.all([
  { slug: 'reddit-product-validation', stage: 'Before you build', text: 'What can Reddit posts tell you about an idea?' },
  { slug: 'community-access-is-not-buyer-access', stage: 'Finding customers', text: 'Are the people in your chosen community likely to need your product?' },
  { slug: 'signups-no-core-feature-use', stage: 'After launch', text: 'Why do people sign up but not use your product?' },
].map(async (item) => {
  const entry = await getEntry('analysis', item.slug);
  if (!entry) throw new Error(`Missing article ${item.slug}`);
  return { ...item, href: articlePath(entry) };
}));

const helpAreas = [
  {
    heading: 'Finding a problem to work on',
    body: 'I help you look into who has the problem, how they deal with it and why a better solution might matter. Research can suggest where to start. Talking to possible customers helps you find out more.',
    href: '/advisory/#find-a-problem',
    link: 'Get help choosing a problem',
  },
  {
    heading: 'Deciding what to build',
    body: 'I help you compare ideas and look at what people already use. You can then decide what your product should do and which parts to test first.',
    href: '/advisory/#decide-what-to-build',
    link: 'Get help with your product idea',
  },
  {
    heading: 'Working out what to try next',
    body: 'You may have a product but few customers. Perhaps people sign up and then stop using it. I help you look into the possible reasons and choose a small test.',
    href: '/advisory/#decide-what-to-try-next',
    link: 'Get help with an existing product',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'PainToBuild',
      url: 'https://paintobuild.com',
      logo: 'https://paintobuild.com/brand/paintobuild-mark-black-1024.png',
      description: 'Help for founders choosing what to build and what to try next.',
    },
    {
      '@type': 'WebSite',
      name: 'PainToBuild',
      url: 'https://paintobuild.com',
    },
  ],
};
---
<BaseLayout title={title} description={description} ogImagePath="/open-graph/index.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero shell-dark">
    <div class="wrap"><div class="hero-inner">
      <Kicker>Help for founders</Kicker>
      <h1>Get help deciding what to build or what to try next</h1>
      <p class="lede">
        You may be choosing an idea, planning a product or trying to find customers. I help you
        look at what you know, work through your options and decide what to test next.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={MAIN_CTA.href}
           data-event="advisory_cta_click" data-event-page="/" data-event-cta-id="hero-main">
          {MAIN_CTA.label}
        </a>
        <a class="hero-link" href="/advisory/">See how I can help</a>
      </div>
    </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="help-heading">
    <h2 id="help-heading">What do you need help with?</h2>
    <div class="three-col">
      {helpAreas.map((area) => (
        <div class="card">
          <h3>{area.heading}</h3>
          <p>{area.body}</p>
          <a href={area.href} data-event="advisory_cta_click" data-event-page="/" data-event-cta-id={`home-area-${area.href.split('#')[1]}`}>{area.link}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="review-heading">
    <div class="wrap section-tight narrow">
      <h2 id="review-heading">Start with one decision</h2>
      <p>
        The Founder Decision Review covers one product or idea and one decision. I write a review
        of what you have tried, what the information suggests and what I recommend testing next.
      </p>
      <p>After you run the test, I review the results once and explain what I think they mean for your next step.</p>
      <p>You and I agree on the work, price and timing before I start.</p>
      <ul class="link-list">
        <li><a href="/advisory/#founder-decision-review">See what the review includes</a></li>
        <li><a href="/example-review/">Read an example</a></li>
      </ul>
    </div>
  </section>

  <section class="wrap section narrow" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <ol class="steps">
      <li>You tell me what you are deciding and what you have tried.</li>
      <li>I review the product and information you share, along with any research agreed in advance.</li>
      <li>I explain the options and recommend a test.</li>
      <li>You run the test. I review what happened and update my advice.</li>
    </ol>
    <p><a href="/methodology/">Read about the process</a></p>
  </section>

  <section class="wrap section narrow" aria-labelledby="research-heading">
    <h2 id="research-heading">Research you can use</h2>
    <p>
      These articles look at problems founders discuss in public. They can help you think of
      questions to ask about your own business.
    </p>
    <ul class="research-list">
      {researchItems.map((item) => (
        <li><strong>{item.stage}:</strong> <a href={item.href}>{item.text}</a></li>
      ))}
    </ul>
    <p><a href="/evidence/">Read the research</a></p>
  </section>

  <section class="wrap section narrow diy" aria-labelledby="diy-heading">
    <h2 id="diy-heading">Want to do the research yourself?</h2>
    <p>
      Start with the free research template. The Builder Validation Brief and Challenge Mining Kit
      offer examples and instructions for doing more of the work yourself.
    </p>
    <p>You do not need to buy a guide before asking me for help.</p>
    <p><a href="/resources/">Compare the guides and tools</a></p>
  </section>

  <CtaBand
    heading="Tell me where you are stuck"
    body="Send a short description of your idea or product and the decision you need to make. I will let you know whether I can help."
    pagePath="/"
    ctaId="home-end"
  />
</BaseLayout>

<style>
  .hero { padding-block: var(--s9); }
  .hero-inner { max-width: 760px; }
  .hero h1 { font-size: var(--t-display); margin-block: var(--s4); }
  .hero .lede { margin: 0 0 var(--s6); }
  .hero-link { color: var(--on-dark-muted); font-weight: 600; }
  .hero-link:hover { color: var(--on-dark); }

  .section { padding-block: var(--s8); }
  .section-tight { padding-block: var(--s8); }
  .narrow > * { max-width: var(--w-prose); }
  .narrow p { margin: 0 0 var(--s4); }
  .narrow h2 { margin-bottom: var(--s4); }

  .three-col { display: grid; gap: var(--s5); grid-template-columns: 1fr; margin-top: var(--s6); }
  @media (min-width: 900px) { .three-col { grid-template-columns: repeat(3, 1fr); } }
  .card {
    background: var(--surface-raised);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    padding: var(--s5);
    display: flex;
    flex-direction: column;
  }
  .card h3 { margin-bottom: var(--s3); }
  .card p { color: var(--ink-soft); margin: 0 0 var(--s4); flex: 1; }
  .card a { font-weight: 700; }

  .band { background: var(--surface-sunken); }

  .steps { padding-left: var(--s5); display: grid; gap: var(--s3); margin: 0 0 var(--s5); }

  .research-list { padding-left: var(--s5); display: grid; gap: var(--s3); margin: 0 0 var(--s5); }
  .research-list strong { color: var(--ink-soft); }
</style>
