---
// Research articles in the "diagnostics" section. Evidence articles use the
// same layout from src/pages/evidence/[...slug].astro. Related links and
// calls to action come from each entry's frontmatter, not from maps here.
import { getCollection, render } from 'astro:content';
import AnalysisLayout from '../../layouts/AnalysisLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('analysis', ({ data }) => data.section === 'diagnostics');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<AnalysisLayout entry={entry} Content={Content} />
