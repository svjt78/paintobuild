---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import Button from '../components/convert/Button.astro';
import ConfidenceTag from '../components/content/ConfidenceTag.astro';

const latestAnalyses = (await getCollection('analysis', ({ data }) => data.section === 'evidence'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const title = 'PainToBuild — Evidence Before You Build';
const description = 'PainToBuild tests your startup idea against real evidence — recurring pain, reachable buyers, actual demand — before you write a line of code.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'PainToBuild',
      url: 'https://paintobuild.com',
      logo: 'https://paintobuild.com/brand/paintobuild-mark-black-1024.png',
    },
    {
      '@type': 'WebSite',
      name: 'PainToBuild',
      url: 'https://paintobuild.com',
    },
  ],
};
---
<BaseLayout title={title} description={description} ogImagePath="/open-graph/index.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero shell-dark">
    <div class="wrap hero-inner">
      <Kicker>For early-stage founders</Kicker>
      <h1>You're about to spend months building something nobody wants.</h1>
      <p class="lede">
        PainToBuild tests your idea against real evidence — recurring pain, reachable
        buyers, actual demand — before you write a line of code.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-dark" href="/tools/evidence-ledger-template/"
           data-event="cta_click" data-event-page="/" data-event-cta-id="hero-template">
          Get the free evidence ledger template
        </a>
        <a class="btn-link" href="/methodology/">See how the evidence works →</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <Kicker>Sound familiar?</Kicker>
    <div class="three-col">
      <div class="col">
        <h3>Is this problem worth pursuing?</h3>
        <p class="muted">Recurring pain, verified across independent sources.</p>
        <a href="/evidence/">Read the evidence hub →</a>
      </div>
      <div class="col">
        <h3>Where are the buyers?</h3>
        <p class="muted">Community access isn't buyer access.</p>
        <a href="/evidence/community-access-is-not-buyer-access/">Read the analysis →</a>
      </div>
      <div class="col">
        <h3>Why isn't launch turning into use?</h3>
        <p class="muted">Signups without activation, diagnosed.</p>
        <a href="/diagnostics/signups-no-core-feature-use/">Read the diagnostic →</a>
      </div>
    </div>
  </section>

  <section class="wrap section how-it-works">
    <Kicker>How the evidence works</Kicker>
    <h2>Four steps, every time</h2>
    <ol class="steps">
      <li>Observe public conversations</li>
      <li>Log signals with independence rules</li>
      <li>Publish a bounded analysis</li>
      <li>State what it does not prove</li>
    </ol>
    <p><a href="/methodology/">Read the full methodology →</a></p>
  </section>

  <section class="wrap section">
    <Kicker>Latest analyses</Kicker>
    <h2>Read the evidence</h2>
    <div class="latest-grid">
      {latestAnalyses.map((entry) => (
        <a class="latest-card" href={`/evidence/${entry.id}/`}>
          <ConfidenceTag confidence={entry.data.confidence} signalCount={entry.data.signalCount} weakSignalCount={entry.data.weakSignalCount} />
          <h3>{entry.data.question}</h3>
          <p class="muted">{entry.data.shortAnswer.split('. ')[0]}.</p>
          <span class="latest-date">Updated {entry.data.updated.toISOString().slice(0, 10)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section not-list">
    <h2>What this is not</h2>
    <ul>
      <li>Not an idea generator.</li>
      <li>Not a community.</li>
      <li>Not an AI tool that scores your idea.</li>
      <li>Not proof anyone will pay.</li>
    </ul>
  </section>

  <section class="wrap section get-started">
    <Kicker>Get started</Kicker>
    <h2>Two ways to get the evidence</h2>
    <div class="products">
      <div class="product-card product-primary">
        <h3>Free evidence ledger template <span class="badge">Start here</span></h3>
        <p class="muted">The column structure behind every analysis on this site.</p>
        <Button href="/tools/evidence-ledger-template/" variant="primary">Get the template →</Button>
      </div>
      <div class="product-card">
        <h3>The Builder Validation Brief — $19</h3>
        <p class="muted">Four worked evidence entries, more added quarterly.</p>
        <Button href="/brief/" variant="secondary">Learn more →</Button>
      </div>
    </div>
    <p class="quiet-line">
      <a href="/analysis/">Need a hands-on read on your specific situation? See Focused Analysis.</a>
      &nbsp;·&nbsp;
      <a href="https://paintobuild.gumroad.com" target="_blank" rel="noopener noreferrer"
         data-event="cta_click" data-event-page="/" data-event-cta-id="footer-line-shop">
        See everything for sale on Gumroad ↗
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: var(--s9); }
  .hero-inner { max-width: 720px; }
  .hero h1 { font-size: var(--t-display); margin-block: var(--s4); }
  .lede { font-size: var(--t-lede); color: var(--on-dark-muted); margin: 0 0 var(--s6); }
  .hero-actions { display: flex; gap: var(--s5); align-items: center; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 var(--s5); border-radius: var(--r-pill);
    font-weight: 700; font-size: var(--t-body-s); text-decoration: none;
  }
  .btn-primary.btn-dark { background: var(--build-on-dark); color: var(--ink); }
  .btn-primary.btn-dark:hover { background: #5BD6BB; }
  .btn-link { color: var(--on-dark-muted); font-weight: 600; text-decoration: underline; }
  .btn-link:hover { color: var(--on-dark); }

  .section { padding-block: var(--s8); }
  .three-col { display: grid; gap: var(--s6); grid-template-columns: 1fr; margin-top: var(--s5); }
  @media (min-width: 768px) { .three-col { grid-template-columns: repeat(3, 1fr); } }
  .col h3 { margin-bottom: var(--s2); }
  .muted { color: var(--muted); }

  .steps { padding-left: var(--s5); display: grid; gap: var(--s3); max-width: var(--w-prose); }

  .not-list ul { list-style: none; padding: 0; display: grid; gap: var(--s2); max-width: var(--w-prose); }
  .not-list li { padding-left: var(--s5); position: relative; }
  .not-list li::before { content: '—'; position: absolute; left: 0; color: var(--muted); }

  .products { display: grid; gap: var(--s5); grid-template-columns: 1fr; margin-top: var(--s5); }
  @media (min-width: 768px) { .products { grid-template-columns: 1fr 1fr; } }
  .product-card {
    background: var(--surface-raised);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    padding: var(--s6);
  }
  .product-card.product-primary { border: 1.5px solid var(--build); }
  .product-card h3 { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; margin-bottom: var(--s2); }
  .badge {
    font-size: var(--t-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pain-strong);
    background: var(--tint-pale);
    border-radius: var(--r-chip);
    padding: 2px var(--s2);
  }
  .quiet-line { color: var(--muted); font-size: var(--t-body-s); margin-top: var(--s5); }

  .latest-grid { display: grid; gap: var(--s5); grid-template-columns: 1fr; margin-top: var(--s5); }
  @media (min-width: 768px) { .latest-grid { grid-template-columns: repeat(3, 1fr); } }
  .latest-card {
    display: block;
    background: var(--surface-raised);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    padding: var(--s5);
    text-decoration: none;
    color: var(--ink);
  }
  .latest-card h3 { font-size: var(--t-h3); margin: var(--s3) 0 var(--s2); }
  .latest-date { display: block; margin-top: var(--s3); font-size: var(--t-caption); color: var(--muted); }
</style>
