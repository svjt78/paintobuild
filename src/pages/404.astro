---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';

const title = 'Page not found | PainToBuild';
const description = 'This page does not exist. Here is where to go instead.';
---
<BaseLayout title={title} description={description} noindex={true}>
  <section class="wrap section prose">
    <Kicker>404</Kicker>
    <h1>That page doesn't exist</h1>
    <p class="lede">The link may be old, or mistyped. Here's where the real content is:</p>
    <ul>
      <li><a href="/methodology/">The methodology</a>: how every analysis on this site is built.</li>
      <li><a href="/evidence/">The evidence library</a>: every published analysis, with sources.</li>
      <li><a href="/tools/evidence-ledger-template/">The free evidence ledger template</a>.</li>
      <li><a href="/">Back to the homepage</a>.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--s8); }
  .lede { font-size: var(--t-lede); color: var(--ink-soft); }
</style>
