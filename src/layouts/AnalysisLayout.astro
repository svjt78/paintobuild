---
// Shared answer-first template — Design & Build Specification v1.1, §9.2.
// Structured fields (notProven, nextTest, sources, confidence) render from
// the content-collection schema, which enforces they exist; free-form
// narrative (what it's based on, what the evidence shows, what it
// probably means, decision criteria) renders from the entry's markdown
// body via <Content />.
import BaseLayout from './BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import ConfidenceTag from '../components/content/ConfidenceTag.astro';
import SourceList from '../components/content/SourceList.astro';
import CtaBand from '../components/convert/CtaBand.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'analysis'>['data'];
  Content: any;
  pagePath: string;
  breadcrumbLabel: string;
  breadcrumbHref: string;
  relatedHref?: string;
  relatedLabel?: string;
  ogImagePath?: string;
  ctaHeading: string;
  ctaBody: string;
  ctaHref: string;
  ctaLabel: string;
}
const {
  data, Content, pagePath, breadcrumbLabel, breadcrumbHref,
  relatedHref, relatedLabel,
  ogImagePath, ctaHeading, ctaBody, ctaHref, ctaLabel,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.published.toISOString(),
  dateModified: data.updated.toISOString(),
  author: { '@type': 'Organization', name: 'PainToBuild' },
  citation: data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })),
};
---
<BaseLayout title={`${data.title} | PainToBuild`} description={data.description} ogImagePath={ogImagePath}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="wrap section prose analysis">
    <p class="breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href={breadcrumbHref}>{breadcrumbLabel}</a> <span aria-hidden="true">/</span> {data.title}</p>
    <Kicker>{breadcrumbLabel} · {data.cluster}</Kicker>

    <div class="meta-row">
      <ConfidenceTag confidence={data.confidence} signalCount={data.signalCount} weakSignalCount={data.weakSignalCount} />
      <span class="window">Evidence window: {data.evidenceWindow.from} to {data.evidenceWindow.to}</span>
    </div>

    <h1>{data.question}</h1>

    {data.forYouIf && (
      <div class="for-you-if">
        <p class="fyi-label">Is this the right page?</p>
        <p>{data.forYouIf}</p>
        {relatedHref && (
          <p class="fyi-link"><a href={relatedHref}>Read {relatedLabel} →</a></p>
        )}
      </div>
    )}

    <div class="short-answer">
      <p class="sa-label">Short answer</p>
      <p class="sa-body">{data.shortAnswer}</p>
    </div>

    <div class="analysis-body">
      <Content />
    </div>

    <section class="not-proven">
      <h2>What it does not prove</h2>
      <ul>
        {data.notProven.map((item: string) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="next-test">
      <h2>Recommended next test</h2>
      <p>{data.nextTest}</p>
    </section>

    <section class="sources-section">
      <h2>Sources and methodology</h2>
      <p class="methodology-link">Scored using PainToBuild's <a href="/methodology/">validation methodology</a> — independence rules, confidence tiers and decision criteria applied the same way to every candidate.</p>
      <SourceList sources={data.sources} pagePath={pagePath} />
    </section>
  </section>

  <CtaBand heading={ctaHeading} body={ctaBody} ctaHref={ctaHref} ctaLabel={ctaLabel} />
</BaseLayout>

<style>
  .section { padding-block: var(--s7) var(--s8); }
  .breadcrumb { font-size: var(--t-caption); color: var(--muted); margin-bottom: var(--s5); }
  .breadcrumb a { color: var(--muted); }
  .breadcrumb a:hover { color: var(--build); }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-wrap: wrap;
    margin: var(--s3) 0 var(--s5);
  }
  .window { font-size: var(--t-caption); color: var(--muted); }

  h1 { margin-bottom: var(--s6); }

  .for-you-if, .short-answer {
    background: var(--surface-sunken);
    border-radius: var(--r-panel);
    padding: var(--s5);
    margin-bottom: var(--s6);
  }
  .fyi-label, .sa-label {
    font-size: var(--t-kicker);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--s2);
  }
  .for-you-if p:last-child { margin: 0; color: var(--ink-soft); }
  .fyi-link { margin-top: var(--s3) !important; }
  .fyi-link a { color: var(--build); font-weight: 600; }
  .short-answer { border-left: 4px solid var(--build); }
  .sa-body { margin: 0; font-size: var(--t-lede); color: var(--ink); font-weight: 600; }

  .analysis-body :global(h2) { margin-top: var(--s8); margin-bottom: var(--s3); }
  .analysis-body :global(p) { margin: 0 0 var(--s4); }
  .analysis-body :global(blockquote) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--t-quote);
    color: var(--ink-soft);
    border-left: 3px solid var(--hairline);
    padding-left: var(--s5);
    margin: var(--s6) 0;
  }
  .analysis-body :global(blockquote p) { margin: 0 0 var(--s2); }
  .analysis-body :global(blockquote p:last-child) {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--t-caption);
    color: var(--muted);
  }
  .analysis-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-body-s);
    margin: var(--s5) 0;
  }
  .analysis-body :global(th), .analysis-body :global(td) {
    text-align: left;
    padding: var(--s3);
    border: 1px solid var(--hairline);
    vertical-align: top;
  }
  .analysis-body :global(th) { background: var(--surface-sunken); }

  .not-proven, .next-test, .sources-section { margin-top: var(--s8); }
  .not-proven h2 { color: var(--pain-strong); }
  .not-proven ul { margin: var(--s3) 0 0; padding-left: var(--s5); }
  .not-proven li { margin-bottom: var(--s3); color: var(--ink-soft); }
  .next-test { background: var(--surface-sunken); border-radius: var(--r-panel); padding: var(--s5); }
  .next-test h2 { color: var(--build); margin-bottom: var(--s2); }
  .next-test p { margin: 0; }
  .methodology-link { color: var(--muted); font-size: var(--t-body-s); }
</style>
