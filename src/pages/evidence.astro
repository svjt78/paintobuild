---
// Research library. Copy: advisory_based_specs/02_Replacement_Copy.md §4.
// The URL stays /evidence/ for old links; the visible name is "Research".
// Articles are grouped by stage from the content collection. No signal
// counts are shown, because they have not been checked against the full
// records.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import { articlePath, stageLabel, stageOrder } from '../lib/routes';

const title = 'Research on common founder questions | PainToBuild';
const description = 'Read about checking product ideas, finding possible customers and understanding why people stop using a product. See what still needs to be tested.';

const entries = await getCollection('analysis', ({ data }) => !data.noindex);
const groups = stageOrder
  .map((stage) => ({ stage, items: entries.filter((e) => e.data.stage === stage) }))
  .filter((g) => g.items.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Research on common founder questions',
  description,
  hasPart: entries.map((e) => ({
    '@type': 'Article',
    headline: e.data.title,
    url: new URL(articlePath(e), 'https://paintobuild.com').toString(),
  })),
};
---
<BaseLayout title={title} description={description} ogImagePath="/open-graph/evidence.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="wrap section prose">
    <Kicker>Research</Kicker>
    <h1>Research on common founder questions</h1>
    <p class="lede">
      These articles draw on problems people discuss in public. They can help you decide what to
      look into. They do not tell you what is causing a problem in your own business.
    </p>

    {groups.map((group) => (
      <section class="group" aria-labelledby={`stage-${group.stage}`}>
        <h2 id={`stage-${group.stage}`}>{stageLabel[group.stage]}</h2>
        {group.items.map((entry) => (
          <div class="article-card">
            <h3>{entry.data.question}</h3>
            <p>{entry.data.cardSummary}</p>
            <a href={articlePath(entry)}>Read the article<span class="visually-hidden">: {entry.data.question}</span></a>
          </div>
        ))}
      </section>
    ))}

    <section class="help panel" aria-labelledby="help-heading">
      <h2 id="help-heading">Need help with your own situation?</h2>
      <p>I can review what you are working on and suggest what to test next.</p>
      <p>
        <a class="btn btn-primary" href="/advisory/"
           data-event="advisory_cta_click" data-event-page="/evidence/" data-event-cta-id="research-end">
          See how I can help
        </a>
      </p>
      <ul class="link-list">
        <li><a href="/resources/">Guides and tools</a></li>
        <li><a href="/methodology/">How I use research</a></li>
      </ul>
    </section>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--s7) var(--s8); }
  .group h2 { margin-top: var(--s7); }
  .article-card {
    background: var(--surface-raised);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-card);
    padding: var(--s5);
  }
  .article-card h3 { margin: 0 0 var(--s2); }
  .article-card p { color: var(--ink-soft); margin: 0 0 var(--s3); }
  .article-card a { font-weight: 700; }
  .help { margin-top: var(--s8); }
  .help h2 { margin-top: 0; }
</style>
