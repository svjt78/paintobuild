---
// Template request confirmation. Copy: advisory_based_specs/02_Replacement_Copy.md §13.
// Kept out of search results (noindex). A visit here does not prove that an
// address was confirmed or that the template arrived.
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/content/Kicker.astro';
import { EMAIL } from '../lib/routes';

const title = 'Confirm your template request | PainToBuild';
const description = 'Check your inbox for the email that asks you to confirm your template request. Contact me if you need help receiving the download.';
---
<BaseLayout title={title} description={description} noindex={true}>
  <section class="wrap section prose">
    <Kicker>Template request</Kicker>
    <h1>Check your inbox</h1>
    <p class="lede">
      If your request went through, you should receive a confirmation email. Follow the link in
      that email to confirm your address and receive the download.
    </p>
    <p class="panel">
      Check your spam or promotions folder if you cannot find it. If it still does not arrive,
      email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> for help.
    </p>
    <p>If you also want help with your product, you can send a separate message through the contact page.</p>
    <ul class="link-list">
      <li><a href={`mailto:${EMAIL}`} data-event="inquiry_email_click" data-event-page="/thank-you/" data-event-cta-id="thank-you-help">Email me for help</a></li>
      <li><a href="/evidence/">Read the research</a></li>
      <li><a href="/contact/">Ask about your product</a></li>
      <li><a href="/">Back to the homepage</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--s8); }
</style>
